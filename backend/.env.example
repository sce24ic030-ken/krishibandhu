# ============================================================
# KrishiBandhu — Environment Configuration
# ============================================================
# 💡 Copy this file to `.env` and fill in your keys.
#    Only the REQUIRED keys are needed for the core app.
# ============================================================

# ------------------------------------------------------------
# REQUIRED — the app cannot run without these
# ------------------------------------------------------------

# Server port
PORT=5000

# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5173

# MongoDB connection string (Atlas free tier is fine)
MONGO_URI=your_mongodb_connection_string

# Secret used for JWT signing, QR tokens and ledger hashing
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret

# Google Gemini API key  →  https://aistudio.google.com
# Powers: AI chat, crop photo analysis, disease detection,
# soil advisor, receipt OCR, multilingual chat, AI dispute
# mediation, fraud detection, route optimization.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model (optional; defaults sensibly if unset)
GEMINI_MODEL=gemini-3.6-flash

# OpenWeather API key  →  https://openweathermap.org
# Powers: Weather tab, pest & weather alerts, sowing signals.
OPENWEATHER_API_KEY=your_openweather_api_key

# ------------------------------------------------------------
# OPTIONAL — graceful demo-mode fallbacks are built in
# ------------------------------------------------------------

# Redis URL for price/analytics caching (Upstash / Redis Cloud)
# Without it, an in-memory cache is used automatically.
# REDIS_URL=rediss://default:token@host:port

# Twilio — SMS price alerts + WhatsApp advisory bot
# (WhatsApp sandbox needs TWILIO_WHATSAPP_FROM, e.g. whatsapp:+14155238886)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exotel — IVR voice system (Phase 2)
# EXOTEL_API_KEY=your_exotel_key
# EXOTEL_API_ID=your_exotel_api_id

# Cloudinary — object storage for lot photos (Phase 2)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Sentinel Hub OAuth — satellite yield prediction (Phase 2)
# SENTINEL_CLIENT_ID=your_sentinel_client_id
# SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# Anchored genesis hash for the trust ledger (optional override)
# ANCHORED_GENESIS_HASH=krishibandhu-genesis-2026-01-01-hash-chain-anchor